# Copy to .env (or set in your host's dashboard). Never commit the real file.

# --- required in production ---
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_PASSWORD=change-me
SITE_URL=https://castlespalv.com
CORS_ORIGINS=https://castlespalv.com
# SQLite file by default. Use Postgres/MySQL on hosts with an ephemeral disk:
#   postgresql+psycopg://user:pass@host/db   (pip install "psycopg[binary]")
#   mysql+pymysql://user:pass@host/db        (pip install pymysql)
DATABASE_URL=sqlite:///./castle.db

# --- booking rules (shown defaults) ---
TIMEZONE=America/Los_Angeles
OPEN_TIME=10:00
CLOSE_TIME=22:00
SLOT_INTERVAL_MINUTES=30
# therapists working at once; a couples massage uses 2
CAPACITY_UNITS=4
MIN_NOTICE_MINUTES=120
BOOKING_HORIZON_DAYS=60
CANCEL_CUTOFF_HOURS=12

# set to true only behind a reverse proxy you control (reads X-Forwarded-For)
TRUST_PROXY=false

# --- email (optional; leave SMTP_HOST empty to disable) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Castle Spa & Massage <castlespa5980@gmail.com>
SMTP_STARTTLS=true
NOTIFY_EMAIL=castlespa5980@gmail.com
